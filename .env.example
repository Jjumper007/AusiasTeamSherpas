# Copy to .env (never commit .env). Get the values from https://mcp-hackathon.sherpaswealth.com/personal-token
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=...
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=sk-...

# Optional
TEXT_MODEL=gpt-5-mini
TTS_MODEL=eleven-flash-v2.5
TTS_VOICE=alloy
PAGES_BASE_URL=https://zzuazo.github.io/ausiasteam

# ---- New backend (backend/) ----
# Voice: ElevenLabs /with-timestamps. Without both, timings are estimated and there is no audio.
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
# ELEVENLABS_MODEL=eleven_flash_v2_5
# 1 = step 2 writes the script with `claude -p` (needs Claude Code installed and logged in)
USE_CLAUDE=0
# Minimum length of a job in ms, so the wait screen can be seen in a demo. 0 = as fast as possible.
DEMO_MS=8000
# API_PORT=3001
